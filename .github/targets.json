{
  "$comment": "Single source of (os, arch) truth for all release workflows. Read at job start via jq and consumed as a matrix include via fromJSON. Adding a new target = adding one entry here; both release-desktop.yml and release-server.yml pick it up automatically (server matrix is linux-only by definition).",
  "desktop": [
    {
      "os": "linux",
      "arch": "amd64",
      "runs_on": "ubuntu-latest",
      "electron_arch_flag": "--x64",
      "artifact_ext": "AppImage"
    },
    {
      "os": "linux",
      "arch": "arm64",
      "runs_on": "ubuntu-24.04-arm",
      "electron_arch_flag": "--arm64",
      "artifact_ext": "AppImage"
    },
    {
      "os": "macos",
      "arch": "arm64",
      "runs_on": "macos-latest",
      "electron_arch_flag": "--arm64",
      "artifact_ext": "zip"
    }
  ],
  "server": [
    {
      "arch": "amd64",
      "runs_on": "ubuntu-latest",
      "rust_target": "x86_64-unknown-linux-musl",
      "linker_env": "CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER"
    },
    {
      "arch": "arm64",
      "runs_on": "ubuntu-24.04-arm",
      "rust_target": "aarch64-unknown-linux-musl",
      "linker_env": "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER"
    }
  ]
}
