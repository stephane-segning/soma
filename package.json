{
  "name": "@soma/desktop",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "contracts:rust": "cargo build -p soma-proto-build",
    "contracts:ts": "pnpm --filter @soma/proto run build",
    "contracts:check": "pnpm run contracts:rust && pnpm run contracts:ts",
    "dev:soma": "pnpm --filter soma run dev",
    "docs:dev": "pnpm --filter @soma/docs run dev",
    "docs:build": "pnpm --filter @soma/docs run build",
    "docs:preview": "pnpm --filter @soma/docs run preview",
    "typecheck": "pnpm --filter soma run typecheck",
    "lint": "pnpm --filter soma run lint",
    "format": "pnpm --filter soma run format"
  },
  "workspaces": [
    "desktop/*",
    "docs"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "core-js",
      "core-js-pure",
      "electron",
      "electron-winstaller",
      "esbuild",
      "grpc-tools",
      "protobufjs"
    ]
  }
}
