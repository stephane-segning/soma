{
  "name": "@soma/proto",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./daemon/*": "./dist/daemon/*.js",
    "./agent/*": "./dist/agent/*.js",
    "./google/*": "./dist/google/*.js",
    "./spaceroom/*": "./dist/spaceroom/*.js"
  },
  "typesVersions": {
    "*": {
      "daemon/*": ["dist/daemon/*"],
      "agent/*": ["dist/agent/*"],
      "google/*": ["dist/google/*"],
      "spaceroom/*": ["dist/spaceroom/*"],
      "*": ["dist/*"]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf src/gen dist",
    "generate": "pnpm run clean && mkdir -p src/gen && pnpm run proto:daemon && pnpm run proto:agent",
    "proto:daemon": "grpc_tools_node_protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=env=node,esModuleInterop=true,forceLong=long,useOptionals=messages,outputServices=grpc-js,outputJsonMethods=false --proto_path=../../proto ../../proto/daemon/v1/daemon.proto",
    "proto:agent": "grpc_tools_node_protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/gen --ts_proto_opt=env=node,esModuleInterop=true,forceLong=long,useOptionals=messages,outputServices=grpc-js,outputJsonMethods=false --proto_path=../../proto ../../proto/agent/v1/agent.proto",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@grpc/grpc-js": "^1.14.3",
    "long": "^5.3.2",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "grpc-tools": "^1.13.1",
    "rimraf": "^6.1.2",
    "ts-proto": "^2.11.0",
    "typescript": "^5.9.3"
  }
}
