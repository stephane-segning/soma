{
	"name": "@soma/soma",
	"version": "1.0.0",
	"description": "An Electron application with React and TypeScript",
	"main": "./out/main/index.js",
	"author": "soma.camer.digital",
	"homepage": "https://soma.camer.digital",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "pnpm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:win": "pnpm build && electron-builder --win",
		"build:mac": "pnpm build && electron-builder --mac",
		"build:linux": "pnpm build && electron-builder --linux",
		"prebuild": "rimraf dist out"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@grpc/grpc-js": "^1.14.3",
		"@grpc/proto-loader": "^0.8.0",
		"@inversifyjs/strongly-typed": "^2.2.0",
		"better-sqlite3": "^12.5.0",
		"electron-log": "^5.4.3",
		"fs-extra": "^11.3.3",
		"inversify": "^7.10.8",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.1.0",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@floating-ui/react": "^0.27.16",
		"@headlessui/react": "^2.2.9",
		"@tailwindcss/postcss": "^4.1.18",
		"@tanstack/react-query": "^5.66.8",
		"@types/better-sqlite3": "^7.6.13",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^22.19.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@yoopta/accordion": "^4.9.9",
