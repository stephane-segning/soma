{
	"name": "soma",
	"version": "1.1.1",
	"description": "Soma desktop workspace app",
	"main": "./out/main/index.js",
	"author": "example.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck:node": "pnpm --filter @soma/desktop-config run build && tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "pnpm --filter @soma/desktop-config run build && electron-vite dev",
		"build": "npm run typecheck && pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:win:dev": "npm run build && electron-builder --win --config electron-builder.dev.yml",
		"build:win:staging": "npm run build && electron-builder --win --config electron-builder.staging.yml",
		"build:mac": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --mac",
		"build:mac:dev": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --mac --config electron-builder.dev.yml",
		"build:mac:staging": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --mac --config electron-builder.staging.yml",
		"build:linux": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --linux",
		"build:linux:dev": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --linux --config electron-builder.dev.yml",
		"build:linux:staging": "pnpm --filter @soma/desktop-config run build && pnpm --filter @soma/ui run build && electron-vite build && electron-builder --linux --config electron-builder.staging.yml"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@floating-ui/react": "^0.27.17",
		"@grpc/grpc-js": "^1.14.3",
		"@grpc/proto-loader": "^0.8.0",
		"@headlessui/react": "^2.2.9",
		"@paralleldrive/cuid2": "^3.3.0",
		"@reduxjs/toolkit": "^2.11.2",
		"@soma/desktop-config": "workspace:*",
		"@soma/desktop-db": "workspace:*",
		"@soma/editor": "workspace:*",
		"@soma/node": "workspace:*",
		"@soma/proto": "workspace:*",
		"@soma/ui": "workspace:*",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"electron-store": "^11.0.2",
		"electron-updater": "^6.7.3",
		"fs-extra": "^11.3.3",
		"highlight.js": "^11.11.1",
		"i18next": "^25.8.0",
		"i18next-browser-languagedetector": "^8.2.0",
		"i18next-chained-backend": "^5.0.2",
		"i18next-http-backend": "^3.0.2",
		"i18next-resources-to-backend": "^1.2.1",
		"inversify": "^7.11.0",
		"jszip": "^3.10.1",
		"long": "^5.3.2",
		"motion": "^12.29.2",
		"prop-types": "^15.8.1",
		"react": "^19.2.4",
		"react-avatar": "^5.0.4",
		"react-cmdk": "^1.3.9",
		"react-dom": "^19.2.4",
		"react-error-boundary": "^6.1.0",
		"react-feather": "^2.0.10",
		"react-hotkeys-hook": "^5.2.3",
		"react-i18next": "^16.5.4",
		"react-redux": "^9.2.0",
		"react-router": "^7.13.0",
		"react-use": "^17.6.0",
		"reflect-metadata": "^0.2.2",
		"rehype-react": "^8.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"tailwind-merge": "^3.4.0",
		"unified": "^11.0.5",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@0xbigboss/vite-console-forward-plugin": "^2.3.3",
		"@biomejs/biome": "^2.3.13",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.1.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-legacy": "^7.2.1",
		"@vitejs/plugin-react": "^5.1.2",
		"cssnano": "^7.1.2",
		"daisyui": "^5.5.16",
		"electron": "^40.1.0",
		"electron-builder": "^26.7.0",
		"electron-vite": "^5.0.0",
		"rimraf": "^6.1.2",
		"rollup": "^4.59.0",
		"sass": "^1.97.3",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"unplugin-turbo-console": "^2.3.0",
		"vite": "^7.3.1",
		"vite-plugin-biome": "^1.1.0",
		"vite-plugin-minify": "^2.1.0",
		"vite-plugin-qrcode": "^0.3.0",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-version-mark": "^0.2.2",
		"vite-plugin-wasm": "^3.5.0",
		"vite-tsconfig-paths": "^6.0.5",
		"vitest": "^4.1.0"
	}
}
