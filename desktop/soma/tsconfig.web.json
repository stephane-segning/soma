{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": [
		"src/renderer/src/vite-env.d.ts",
		"src/renderer/src/**/*",
		"src/renderer/src/**/*.tsx",
		"src/preload/*.d.ts"
	],
	"compilerOptions": {
		"composite": true,
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@renderer/*": ["src/renderer/src/*"],
			"@main/*": ["src/main/*"]
		}
	}
}
