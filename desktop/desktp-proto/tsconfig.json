{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src/gen",
    "resolveJsonModule": true,
    "declaration": true,
    "composite": false,
    "types": ["node", "react"],
    "jsx": "react-jsx"
  },
  "include": ["src/gen/**/*"]
}
