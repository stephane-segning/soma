{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Soma Desktop (Tauri spike)",
	"version": "0.1.0",
	"identifier": "digital.camer.soma.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Soma (Tauri spike)",
				"width": 1280,
				"height": 800,
				"minWidth": 720,
				"minHeight": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["soma"]
			}
		},
		"updater": {
			"endpoints": [],
			"pubkey": ""
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
