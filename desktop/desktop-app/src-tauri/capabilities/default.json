{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capability for the main window.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-start-resize-dragging",
		"opener:default",
		"store:default",
		"log:default",
		"os:default",
		"dialog:default",
		"fs:default",
		"shell:default",
		"process:default",
		"window-state:default",
		"deep-link:default",
		"updater:default"
	]
}
