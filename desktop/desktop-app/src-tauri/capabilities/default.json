{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capability for the main window (all platforms — desktop + mobile).",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-start-resize-dragging",
		"opener:default",
		"store:default",
		"log:default",
		"os:default",
		"dialog:default",
		"fs:default",
		"shell:default",
		"deep-link:default"
	]
}
