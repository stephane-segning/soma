{
  "name": "@soma/packaging",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "soma-packaging": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "pnpm run build && node dist/index.js",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "nunjucks": "^3.2.4",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.1",
    "@types/nunjucks": "^3.2.6",
    "@types/yargs": "^17.0.32",
    "typescript": "^5.9.3"
  }
}
