{
	"name": "@soma/packaging",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"bin": {
		"soma-packaging": "dist/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"bundle": "pnpm run build && node dist/index.js",
		"bundle:release": "pnpm run build && node dist/index.js release",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"execa": "^9.6.1",
		"fs-extra": "^11.3.3",
		"nunjucks": "^3.2.4",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.1.0",
		"@types/nunjucks": "^3.2.6",
		"@types/yargs": "^17.0.35",
		"typescript": "^5.9.3"
	}
}
