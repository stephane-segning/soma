#!/usr/bin/env bash
set -euo pipefail

BUNDLE_VERSION="{{bundle_version}}"
BUNDLE_TAG="bundle-{{bundle_version}}"
REPO="{{repo}}"
SERVICE_LABEL_DAEMON="{{service_label_daemon}}"
SERVICE_LABEL_AGENT="{{service_label_agent}}"
MACOS_APP_DIR="/Applications/Soma"

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"

case "$os" in
  linux) OS=linux ;;
  darwin) OS=macos ;;
  *) echo "unsupported OS: $os" >&2; exit 1 ;;
esac

case "$arch" in
  x86_64|amd64) ARCH=amd64 ;;
  arm64|aarch64) ARCH=arm64 ;;
  *) echo "unsupported arch: $arch" >&2; exit 1 ;;
esac

base="https://github.com/$REPO/releases/download"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

cleanup_legacy_root_install() {
  if [ "$OS" = "macos" ]; then
    sudo launchctl bootout system "/Library/LaunchDaemons/${SERVICE_LABEL_DAEMON}.plist" 2>/dev/null || true
    sudo launchctl bootout system "/Library/LaunchDaemons/${SERVICE_LABEL_AGENT}.plist" 2>/dev/null || true
    sudo rm -f "/Library/LaunchDaemons/${SERVICE_LABEL_DAEMON}.plist" 2>/dev/null || true
    sudo rm -f "/Library/LaunchDaemons/${SERVICE_LABEL_AGENT}.plist" 2>/dev/null || true

    if [ -S "/tmp/soma-daemon.sock" ] && [ "$(stat -f '%u' /tmp/soma-daemon.sock 2>/dev/null || echo '')" = "0" ]; then
      sudo rm -f "/tmp/soma-daemon.sock" || true
    fi
    if [ -S "/tmp/soma-agentd.sock" ] && [ "$(stat -f '%u' /tmp/soma-agentd.sock 2>/dev/null || echo '')" = "0" ]; then
      sudo rm -f "/tmp/soma-agentd.sock" || true
    fi
    return
  fi

  sudo systemctl stop soma-daemon.service soma-agentd.service 2>/dev/null || true
  sudo systemctl disable soma-daemon.service soma-agentd.service 2>/dev/null || true
  sudo rm -f "/etc/systemd/system/soma-daemon.service" "/etc/systemd/system/soma-agentd.service" 2>/dev/null || true
  sudo rm -f "/usr/lib/systemd/system/soma-daemon.service" "/usr/lib/systemd/system/soma-agentd.service" 2>/dev/null || true
  sudo systemctl daemon-reload 2>/dev/null || true

  if [ -S "/tmp/soma-daemon.sock" ] && [ "$(stat -c '%u' /tmp/soma-daemon.sock 2>/dev/null || echo '')" = "0" ]; then
    sudo rm -f "/tmp/soma-daemon.sock" || true
  fi
  if [ -S "/tmp/soma-agentd.sock" ] && [ "$(stat -c '%u' /tmp/soma-agentd.sock 2>/dev/null || echo '')" = "0" ]; then
    sudo rm -f "/tmp/soma-agentd.sock" || true
  fi
}

cleanup_legacy_root_install

start_macos_launch_agent() {
  local label="$1"
  local plist="/Library/LaunchAgents/${label}.plist"
  local domain="gui/$(id -u)"

  if [ ! -f "$plist" ]; then
    echo "Missing $plist after install." >&2
    return 1
  fi

  launchctl bootout "$domain" "$plist" 2>/dev/null || true
  if ! launchctl bootstrap "$domain" "$plist" 2>/dev/null; then
    if ! launchctl print "$domain/$label" >/dev/null 2>&1; then
      echo "Unable to load $plist. Try: launchctl bootstrap $domain $plist" >&2
      return 1
    fi
  fi

  launchctl kickstart -k "$domain/$label" 2>/dev/null || true
}

if [ "$OS" = "macos" ]; then
  PKG="soma-bundle-$BUNDLE_VERSION-macos-$ARCH.pkg"
  URL="$base/$BUNDLE_TAG/$PKG"
  curl -fsSL "$URL" -o "$tmp/$PKG"
  echo "Downloaded $PKG"
  sudo installer -pkg "$tmp/$PKG" -target /
  # Clear quarantine on the installed unsigned apps (dev distribution).
  xattr -dr com.apple.quarantine "$MACOS_APP_DIR/soma.app" 2>/dev/null || true
  xattr -cr "$MACOS_APP_DIR/soma.app" 2>/dev/null || true
  xattr -dr com.apple.quarantine "$MACOS_APP_DIR/tapia.app" 2>/dev/null || true
  xattr -cr "$MACOS_APP_DIR/tapia.app" 2>/dev/null || true

  services_missing=0
  start_macos_launch_agent "$SERVICE_LABEL_DAEMON" || services_missing=1
  start_macos_launch_agent "$SERVICE_LABEL_AGENT" || services_missing=1

  missing=0
  for app in soma tapia; do
    if [ ! -d "$MACOS_APP_DIR/$app.app" ]; then
      echo "Missing $MACOS_APP_DIR/$app.app after install." >&2
      missing=1
    fi
  done
  if [ "$missing" -ne 0 ] || [ "$services_missing" -ne 0 ]; then
    echo "Install appears incomplete. Check /var/log/install.log and pkgutil --files digital.camer.soma.bundle" >&2
    exit 1
  fi
  echo "Installed bundle package (includes soma-daemon, soma-agentd, soma, and tapia)"
elif [ "$OS" = "linux" ]; then
  DEB="soma-bundle-$BUNDLE_VERSION-linux-$ARCH.deb"
  RPM="soma-bundle-$BUNDLE_VERSION-linux-$ARCH.rpm"
  if command -v dpkg >/dev/null 2>&1; then
    URL="$base/$BUNDLE_TAG/$DEB"
    curl -fsSL "$URL" -o "$tmp/$DEB"
    echo "Downloaded $DEB"
    sudo dpkg -i "$tmp/$DEB"
    echo "Installed bundle package (includes soma-daemon, soma-agentd, soma AppImage, and tapia AppImage)"
  elif command -v rpm >/dev/null 2>&1; then
    URL="$base/$BUNDLE_TAG/$RPM"
    curl -fsSL "$URL" -o "$tmp/$RPM"
    echo "Downloaded $RPM"
    sudo rpm -Uvh "$tmp/$RPM"
    echo "Installed bundle package (includes soma-daemon, soma-agentd, soma AppImage, and tapia AppImage)"
  else
    echo "No supported package manager found (need dpkg or rpm)" >&2
    exit 1
  fi
fi

echo "Release page: https://github.com/$REPO/releases/tag/$BUNDLE_TAG"
