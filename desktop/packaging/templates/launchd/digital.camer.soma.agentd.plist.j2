<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{service_label_agent}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/Library/Logs/Soma/agentd" &amp;&amp; exec "{{install_prefix}}/bin/soma-agentd" --socket-path /tmp/soma-agentd.sock</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SOMA_LOGS_DIR</key>
    <string>$HOME/Library/Logs/Soma/agentd</string>
    <key>SOMA_LOG_FORMAT</key>
    <string>json</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
