{
	"name": "@soma/desktop-config",
	"version": "0.1.1",
	"private": true,
	"type": "commonjs",
	"main": "./dist/stage-config.js",
	"types": "./dist/stage-config.d.ts",
	"exports": {
		".": {
			"types": "./dist/stage-config.d.ts",
			"require": "./dist/stage-config.js",
			"default": "./dist/stage-config.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepare": "pnpm run build",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"format": "biome format --write .",
		"lint": "biome check --write ."
	},
	"peerDependencies": {
		"electron": "^39.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@types/node": "^25.1.0",
		"electron": "^40.1.0",
		"typescript": "^5.9.3"
	}
}
