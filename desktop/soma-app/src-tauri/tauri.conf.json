{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "soma-app",
	"version": "0.1.1",
	"identifier": "digital.camer.sschool.soma",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "soma-app",
				"minWidth": 720,
				"minHeight": 480,
				"width": 800,
				"height": 600,
				"decorations": false,
				"transparent": true,
				"windowEffects": {
					"radius": 12,
					"effects": ["windowBackground"]
				}
			}
		],
		"security": {
			"csp": null
		},
		"macOSPrivateApi": true
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["soma", "soma-blob"]
			}
		}
	}
}
