{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"vcs": { "enabled": true, "useIgnoreFile": true, "clientKind": "git" },
	"files": {
		"includes": ["**", "!src/bindings"]
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": true,
			"source": { "recommended": true, "organizeImports": "on" }
		}
	},
	"formatter": { "enabled": true, "indentWidth": 2, "lineWidth": 120 },
	"linter": { "enabled": true, "rules": { "recommended": true } }
}
